# ===========================================
# Penny101 環境變數設定檔
# ===========================================
# 使用說明：
# 1. 複製此檔案並重新命名為 .env
# 2. 根據你的環境修改變數值
# 3. 絕對不要將 .env 提交到 Git
# ===========================================

# -------------------------------------------
# 資料庫連線設定
# -------------------------------------------

# PostgreSQL 連線字串
# 格式：postgresql://[使用者]:[密碼]@[主機]:[Port]/[資料庫名稱]
# 開發環境：使用 Docker Compose 的預設設定
DATABASE_URL=postgresql://penny101:penny101_dev_password@localhost:5432/penny101

# 生產環境範例（請更換為強密碼）：
# DATABASE_URL=postgresql://penny101:YOUR_STRONG_PASSWORD@your-db-host:5432/penny101

# PostgreSQL 密碼（用於 Docker Compose）
# 注意：此密碼用於建立 Docker 容器中的資料庫
POSTGRES_PASSWORD=penny101_dev_password

# 生產環境請使用強密碼：
# - 至少 20 個字元
# - 包含大小寫字母、數字、特殊符號
# - 不要使用常見單字或個人資訊
# POSTGRES_PASSWORD=Your_Super_Str0ng_P@ssw0rd_Here

# -------------------------------------------
# 應用程式設定
# -------------------------------------------

# Node 環境
# 開發：development
# 生產：production
NODE_ENV=development

# -------------------------------------------
# 時區設定
# -------------------------------------------

# 應用程式時區（固定為台灣時間）
# 警告：不要修改此值，否則會影響時間計算正確性
TZ=Asia/Taipei

# -------------------------------------------
# Next.js 設定（可選）
# -------------------------------------------

# Next.js 伺服器 Port（預設 3000）
# PORT=3000

# Next.js Host（預設 localhost）
# HOSTNAME=localhost

# -------------------------------------------
# 備份設定（可選）
# -------------------------------------------

# Google Drive 備份設定
# 如果使用自動備份腳本，請設定以下變數

# rclone remote 名稱（執行 rclone config 設定）
# RCLONE_REMOTE=gdrive

# Google Drive 備份資料夾路徑
# GDRIVE_BACKUP_FOLDER=Penny101_Backups

# 保留備份天數（預設 30 天）
# BACKUP_RETENTION_DAYS=30

# -------------------------------------------
# 開發工具設定（可選）
# -------------------------------------------

# Drizzle Studio Host（預設 127.0.0.1）
# DRIZZLE_STUDIO_HOST=127.0.0.1

# Drizzle Studio Port（預設 4983）
# DRIZZLE_STUDIO_PORT=4983

# -------------------------------------------
# 日誌設定（可選）
# -------------------------------------------

# 日誌等級（error, warn, info, debug）
# LOG_LEVEL=info

# 是否啟用詳細日誌
# VERBOSE_LOGGING=false

# ===========================================
# 安全提醒
# ===========================================
#
# ⚠️  生產環境部署前務必：
# 1. 更換所有預設密碼為強密碼
# 2. 確認 .env 檔案權限（chmod 600 .env）
# 3. 檢查 .gitignore 已包含 .env
# 4. 定期更換密碼
# 5. 不要在公開場合分享環境變數
#
# ===========================================
